module mem8(
    input         clk,
    input  [3:0]  addr,       
    input  [7:0]  data_in,    
    input         mem_read,   
    input         mem_write,  
    output reg [7:0] data_out 
);

    reg [7:0] mem [0:15];   

    initial begin
        mem[0]  = 8'b10000101; // LOAD 5
        mem[1]  = 8'b00000110; // ADD 6
        mem[2]  = 8'b10010111; // STORE 7
        mem[3]  = 8'b11000000; // HALT
        mem[4]  = 8'b00000000; // unused
        mem[5]  = 8'd60;       // operand A = 60
        mem[6]  = 8'd30;       // operand B = 30
        mem[7]  = 8'd0;        // result, written by STORE at runtime
        mem[8]  = 8'b00000000;
        mem[9]  = 8'b00000000;
        mem[10] = 8'b00000000;
        mem[11] = 8'b00000000;
        mem[12] = 8'b00000000;
        mem[13] = 8'b00000000;
        mem[14] = 8'b00000000;
        mem[15] = 8'b00000000;
            $display("========== Memory Initialization ==========");
    $display("mem[5] = %d", mem[5]);
    $display("mem[6] = %d", mem[6]);
    $display("==========================================");
    end

    always @(*)
    begin
        if (mem_read)
            data_out = mem[addr];
        else
            data_out = 8'b0;
    end

    always @(posedge clk)
    begin
        if (mem_write)
            mem[addr] <= data_in;
    end

endmodule

